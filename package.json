{
  "name": "open-inspector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @open-inspector/extension dev",
    "dev:firefox": "pnpm --filter @open-inspector/extension dev:firefox",
    "build": "pnpm --filter @open-inspector/extension build",
    "build:firefox": "pnpm --filter @open-inspector/extension build:firefox",
    "zip": "pnpm --filter @open-inspector/extension zip",
    "typecheck": "tsc --build --force && pnpm -r --filter './apps/*' typecheck && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "e2e": "playwright test",
    "e2e:headed": "HEADED=1 playwright test",
    "launch": "node scripts/launch-browser.mjs",
    "lint": "eslint .",
    "check:egress": "node scripts/check-zero-egress.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:egress",
    "sweep": "node scripts/reliability-sweep.mjs",
    "gen:promo": "node scripts/gen-promo.mjs store/promo/src",
    "gen:store": "node scripts/gen-launch-details.mjs && node scripts/gen-launch-media.mjs",
    "site:dev": "node scripts/serve-site.mjs",
    "check:site": "node scripts/check-site-contrast.mjs && node scripts/check-site-images.mjs && pnpm check:shots",
    "gen:shots": "node scripts/gen-site-shots.mjs && node scripts/gen-site-shots.mjs dark && node scripts/frame-site-shots.mjs && pnpm shots:optimize",
    "shots:optimize": "node scripts/shotkit.mjs optimize apps/site/public/shots",
    "check:shots": "node scripts/shotkit.mjs check apps/site/public/shots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@open-inspector/core": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.6",
    "@types/node": "^22.10.2",
    "@vitest/browser": "2.1.9",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "happy-dom": "^15.11.7",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
